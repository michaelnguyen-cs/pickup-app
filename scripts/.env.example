# Copy this file to scripts/.env and fill in real values.
# scripts/.env is gitignored — never commit it.
# This is a separate credential set from the app's .env.local; nothing here
# is read by the Expo app, and import-venues.ts never reads .env.local.

# Google Places API (New) key with Places API (New) enabled.
# https://console.cloud.google.com/apis/credentials
GOOGLE_PLACES_API_KEY=

# Same Supabase project as the app's EXPO_PUBLIC_SUPABASE_URL, but this script
# needs the URL again here because it deliberately does not read .env.local.
SUPABASE_URL=

# Service role key (Dashboard → Project Settings → API → service_role).
# Required because public.venues has no INSERT policy for anon/authenticated —
# only the service role can write to it. Treat this like a root password:
# never commit it, never put it in client-side code, never share it.
SUPABASE_SERVICE_ROLE_KEY=
